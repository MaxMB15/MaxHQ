{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		// No DOM: the code here runs in React Native too, so a DOM global
		// fails the typecheck. globals.d.ts declares what both have.
		"lib": ["ES2022"],
		"types": [],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
