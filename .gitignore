# User-facing docs, such as the README, SECURITY.md and CONTRIBUTING.md, are
# tracked. Plans, briefs, research and other implementation notes stay on the
# machine that wrote them, in docs/. So do the benchmark notes.
/docs/
/scripts/bench/README.md

# Benchmark recordings of real agent sessions. They can hold private
# output, so they stay on the machine that recorded them.
scripts/bench/traces/

# Tauri writes its permission schemas here on every build.
apps/desktop/src-tauri/gen/
