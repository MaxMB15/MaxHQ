		"expo-localization": "^58.0.5",
		"expo-notifications": "~58.1.7",
		"expo-status-bar": "~58.0.3",
		"katex": "^0.19.1",
		"lucide-react-native": "1.61.0",
		"marked": "catalog:",
		"maxhq-core": "link:./modules/maxhq-core",
		"mermaid": "^11.17.2",
		"react": "catalog:",
		"react-native": "0.88.0",
		"react-native-enriched-markdown": "1.1.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
