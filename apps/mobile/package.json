{
	"name": "maxhq-mobile",
	"private": true,
	"license": "MIT",
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"prebuild": "expo prebuild --clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"push:test": "swift test --package-path targets/push",
		"mobile:core": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts core",
		"mobile:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts dev",
		"mobile:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts install",
		"mobile:testflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts testflight",
		"mobile:archive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts archive",
		"mobile:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts check",
		"mobile:android:core": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts android-core",
		"mobile:android:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts android-dev",
		"mobile:android:apk": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts android-apk",
		"mobile:android:aab": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts android-aab",
		"mobile:android:release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile.ts android-release"
	},
	"dependencies": {
		"@formatjs/intl-getcanonicallocales": "^3.3.1",
		"@formatjs/intl-listformat": "^9.0.3",
		"@formatjs/intl-locale": "^5.4.3",
		"@formatjs/intl-pluralrules": "^7.0.4",
		"@formatjs/intl-relativetimeformat": "^13.0.3",
		"@maxhq/shared": "workspace:*",
		"@react-native-community/datetimepicker": "9.2.1",
		"@react-native-community/netinfo": "12.0.1",
		"@react-navigation/native": "7.5.1",
		"@react-navigation/native-stack": "7.21.0",
		"@ubjs/core": "npm:uniffi-bindgen-react-native@0.31.0-6",
		"chart.js": "4.5.1",
		"d3": "7.9.2",
		"expo": "58.0.14",
		"expo-camera": "~58.0.14",
		"expo-clipboard": "~58.0.3",
		"expo-constants": "~58.0.14",
