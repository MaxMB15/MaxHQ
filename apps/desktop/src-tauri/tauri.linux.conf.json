{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "MaxHQ",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 600,
				"backgroundThrottling": "throttle"
			}
		]
	},
	"bundle": {
		"targets": ["appimage", "deb", "rpm"],
		"category": "DeveloperTool",
		"shortDescription": "Coding agents on every computer you use, in one app",
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png"
		],
		"linux": {
			"deb": {
				"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "openssh-client"],
				"recommends": ["libunity9"],
				"section": "devel"
			},
			"rpm": {
				"depends": ["webkit2gtk4.1", "gtk3", "openssh-clients"]
			},
			"appimage": {
				"bundleMediaFramework": false
			}
		}
	}
}
